{
  "name": "lc-hot100-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:practice && next dev",
    "build": "npm run prepare:practice && next build",
    "preview": "wrangler pages dev out",
    "preview:local": "node ../tools/dev/preview.mjs",
    "dev:resources": "node ../tools/dev/resource-api.mjs",
    "test:dev-resources": "node ../tools/dev/resource-api.test.mjs",
    "test": "node lib/sync/test/sync.test.ts && node lib/practice/test/record.test.ts && node lib/practice/test/save-queue.test.ts && node functions/_lib/test/sso.test.ts",
    "deploy": "npm run build && wrangler pages deploy out",
    "prepare:practice": "node ../tools/practice-runtime/prepare.mjs",
    "generate:practice": "node ../tools/practice/build.cjs",
    "test:practice-data": "node ../tools/practice/test.cjs",
    "test:practice-ui": "node ../tools/practice-ui/test.mjs",
    "test:practice-runtime": "node ../tools/practice-runtime/test.mjs && node ../tools/practice-runtime/debug.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.15",
    "@heroui-pro/react": "1.0.0-beta.11",
    "@heroui/react": "3.0.4",
    "@heroui/styles": "3.0.4",
    "@lezer/highlight": "^1.2.5",
    "@number-flow/react": "^0.6.0",
    "@uiw/react-codemirror": "^4.25.12",
    "clsx": "2.1.1",
    "motion": "^12.39.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "react": "19.2.6",
    "react-aria-components": "^1.17.0",
    "react-dom": "19.2.6",
    "react-is": "19.2.6",
    "shiki": "^4.4.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "20.9.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.6",
    "pyodide": "^314.0.8",
    "tailwindcss": "4.1.11",
    "typescript": "5.6.3",
    "wrangler": "^4.162.0"
  }
}

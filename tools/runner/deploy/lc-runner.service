[Unit]
Description=lc-hot100 远端运行器（tools/runner）
# 每次运行一台 Firecracker microVM（fc-manager）；开发测试用 Docker 时排在 docker 之后
After=network-online.target fc-manager.service docker.service
Wants=fc-manager.service

[Service]
User=lc-runner
Group=lc-runner
EnvironmentFile=/etc/lc-runner.env
Environment=HOME=/tmp DOCKER_CONFIG=/tmp/docker
WorkingDirectory=/opt/lc-runner
ExecStart=/usr/local/bin/node /opt/lc-runner/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codingdance.cn/schemas/problem.schema.json",
  "title": "CodingDance Declarative Problem Contract",
  "type": "object",
  "required": ["id", "name", "level", "topic", "h1", "lede", "sig", "hints", "points", "codeEntries"],
  "properties": {
    "id": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "name": { "type": "string", "minLength": 1 },
    "level": { "type": "string", "enum": ["简单", "中等", "困难"] },
    "topic": { "type": "string", "minLength": 1 },
    "h1": { "type": "string" },
    "lede": { "type": "string" },
    "handwritten": { "type": "boolean" },
    "sig": { "type": "object" },
    "hints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "body"],
        "properties": {
          "t": { "type": "string" },
          "body": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "body"],
        "properties": {
          "t": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "args"],
        "properties": {
          "label": { "type": "string" },
          "args": { "type": "object" },
          "note": { "type": "string" }
        }
      }
    },
    "fixedCases": { "type": "integer", "minimum": 0 },
    "codeEntries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "title", "files"],
        "properties": {
          "key": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] },
          "files": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}
